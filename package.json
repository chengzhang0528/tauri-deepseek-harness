{
  "name": "atlas-dsh-desktop",
  "private": true,
  "scripts": {
    "build:native": "cargo +stable-x86_64-pc-windows-gnu build --release --manifest-path src-tauri/Cargo.toml",
    "build:msi": "node scripts/build-msi.mjs",
    "check:docs": "node --test 文档/check-docs-human.test.mjs 文档/check-docs-phases.test.mjs 文档/check-docs-references.test.mjs && node 文档/check-docs.mjs",
    "docs:check": "npm run check:docs",
    "test:docs": "node --test 文档/check-docs-human.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
